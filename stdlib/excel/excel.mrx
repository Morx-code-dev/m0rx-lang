fn xlsxSave(wb: any, path: str) -> bool { }
fn xlsxClose(wb: any) -> nil { }
fn xlsxSheets(wb: any) -> list { }
fn xlsxAddSheet(wb: any, name: str) -> any { }
fn xlsxGetSheet(wb: any, name: str) -> any { }
