fn xlsxRenameSheet(wb: any, old: str, new: str) -> bool { }

// ===== Read / Write Cells =====
fn xlsxRead(sheet: any, row: ant, col: ant) -> any { }
fn xlsxWrite(sheet: any, row: ant, col: ant, value: any) -> nil { }
