// ===== Deque =====
class Deque {
    let data: list = []

    fn addFront(value: any) -> nil {
        push(data, value)
    }

    fn addBack(value: any) -> nil {
        append(data, value)
    }

    fn removeFront() -> any {
        give pull(data)
    }

    fn removeBack() -> any {
        give remove(data, length(data) - 1)
    }

    fn isEmpty() -> bool {
        give length(data) == 0
    }
}
