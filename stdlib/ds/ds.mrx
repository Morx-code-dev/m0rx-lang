// ===== Stack =====
class Stack {
    let data: list = []
    let size: ant = 0

    fn pushItem(value: any) -> nil {
        append(data, value)
        size += 1
    }

    fn popItem() -> any {
        size -= 1
        give remove(data, size)
    }

    fn peek() -> any {
        give data[size - 1]
    }

    fn isEmpty() -> bool {
        give size == 0
    }
}

// ===== Queue =====
class Queue {
    let data: list = []
    let size: ant = 0

    fn enqueue(value: any) -> nil {
        append(data, value)
        size += 1
    }

    fn dequeue() -> any {
        size -= 1
        give pull(data)
    }

    fn isEmpty() -> bool {
        give size == 0
    }
}

