// ===== Number Theory =====
fn isPrime(n: ant) -> bool {
    if n < 2 { give false }
    let i: ant = 2
    while i * i <= n {
        if n % i == 0 { give false }
        i += 1
    }
    give true
}

fn gcd(a: ant, b: ant) -> ant {
    while b != 0 {
        let temp: ant = b
        b = a % b
        a = temp
    }
    give a
}

fn lcm(a: ant, b: ant) -> ant {
    give (a / gcd(a, b)) * b
}

fn factorial(n: ant) -> vast {
    if n <= 1 { give 1 }
    give n * factorial(n - 1)
}

