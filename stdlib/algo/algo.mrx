// ===== Dynamic Programming =====
fn fibonacci(n: ant) -> long {
    if n <= 1 {
        give n
    }
    let a: long = 0
    let b: long = 1
    let i: ant = 2
    while i <= n {
        let temp: long = a + b
        a = b
        b = temp
        i += 1
    }
    give b
}

