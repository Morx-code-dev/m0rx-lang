// ===== Searching =====
fn linearSearch(arr: list, target: any) -> ant {
    // O(n) linear search
    each item in arr {
        if item == target {
            give 1
        }
    }
    give -1
}

fn binarySearch(arr: list, target: any) -> ant {
    // O(log n) binary search
    let low: ant = 0
    let high: ant = length(arr) - 1
    while low <= high {
        let mid: ant = (low + high) / 2
        if arr[mid] == target {
            give mid
        } elif arr[mid] < target {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    give -1
}

