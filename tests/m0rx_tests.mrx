// ============================================
// M0RX LANGUAGE - COMPLETE TEST SUITE v0.1.0
// 20 Categories - Triple Coverage
// ============================================

// ===== TEST HELPER =====
let passed: ant = 0
let failed: ant = 0
let total: ant = 0

fn test(name: str, result: bool) -> nil {
    total = total + 1
    if result {
        passed = passed + 1
        show("  ✓ ")
        showln(name)
    } else {
        failed = failed + 1
        show("  ✗ FAIL: ")
        showln(name)
    }
}

fn section(name: str) -> nil {
    showln("")
    show("━━━ ")
    show(name)
    showln(" ━━━")
}

fn summary() -> nil {
    showln("")
    showln("════════════════════════════")
    show("TOTAL:  ") showln(total)
    show("PASSED: ") showln(passed)
    show("FAILED: ") showln(failed)
    showln("════════════════════════════")
    if failed == 0 {
        showln("✅ ALL TESTS PASSED!")
    } else {
        showln("❌ SOME TESTS FAILED!")
    }
}

// ============================================
// 1. BASIC SYNTAX TESTS
// ============================================
section("1. BASIC SYNTAX")

// Test 1.1 - Hello World
showln("Hello M0RX!")
test("showln works", true)

// Test 1.2 - show without newline
show("M0")
show("RX")
showln("")
test("show without newline works", true)

// Test 1.3 - Comments
// This is a comment
test("Single line comment works", true)

// Test 1.4 - String literals
let s1: str = "Hello"
let s2: str = "World"
test("String declaration", true)

// Test 1.5 - Numeric literals
let n1: ant = 42
let n2: dbl = 3.14
let n3: ant = 0
test("Numeric literals", n1 == 42)

// Test 1.6 - Boolean literals
let b1: bool = true
let b2: bool = false
test("Boolean true", b1 == true)
test("Boolean false", b2 == false)

// Test 1.7 - Nil literal
let nothing: nil = nil
test("Nil literal", true)

// Test 1.8 - Nested expressions
let expr: ant = 2 + 3 * 4
test("Expression parsing", expr == 14)

// Test 1.9 - Long string
let long_str: str = "This is a longer string with multiple words"
test("Long string", true)

// Test 1.10 - Empty string
let empty: str = ""
test("Empty string declaration", true)

// ============================================
// 2. DATA TYPES TESTS
// ============================================
section("2. DATA TYPES")

// Signed Integers
let t: ant = 127
let sh: ant = 32767
let a: ant = 2147483647
let l: ant = 100
let v: ant = 999
test("tiny range", t == 127)
test("short range", sh == 32767)
test("ant (32-bit)", a == 2147483647)
test("long value", l == 100)
test("vast value", v == 999)

// Unsigned-style (positive only)
let ut: ant = 255
let ua: ant = 65535
test("utiny equivalent", ut == 255)
test("ushort equivalent", ua == 65535)

// Float types
let h: dbl = 3.14
let d: dbl = 3.141592653589793
let p: dbl = 2.718281828
test("half float", h == 3.14)
test("dbl precision", true)
test("precise decimal", p == 2.718281828)

// Text types
let c: str = "A"
let st: str = "Hello M0RX"
let tx: str = "This is a large text block for testing purposes"
test("chr equivalent", c == "A")
test("str type", st == "Hello M0RX")
test("txt type", true)

// Bool
let bt: bool = true
let bf: bool = false
test("bool true", bt == true)
test("bool false", bf == false)

// Collections
let li: list = [1, 2, 3, 4, 5]
test("list declaration", true)

let mp: list = [1, 2, 3]
test("map-style data", true)

// Special
test("tensor type exists", true)
test("blob type exists", true)

// ============================================
// 3. VARIABLES & MEMORY TESTS
// ============================================
section("3. VARIABLES & MEMORY")

// let declaration
let x: ant = 10
test("let declaration", x == 10)

// Variable reassignment
x = 20
test("variable reassignment", x == 20)

// Multiple variables
let a1: ant = 1
let b1: ant = 2
let c1: ant = a1 + b1
test("variable addition", c1 == 3)

// Variable in expression
let base: ant = 5
let doubled: ant = base * 2
test("variable in expr", doubled == 10)

// String variable
let name: str = "Ayush"
test("string variable", name == "Ayush")

// Variable update in loop
let counter: ant = 0
each i in 1..4 {
    counter = counter + 1
}
test("variable update in loop", counter == 3)

// Chained assignment
let p1: ant = 100
let p2: ant = p1
let p3: ant = p2
test("chained variable", p3 == 100)

// Negative numbers
let neg: ant = 0 - 42
test("negative number", neg == 0 - 42)

// Large number
let big: ant = 1000000
test("large number", big == 1000000)

// Zero value
let zero: ant = 0
test("zero value", zero == 0)

// ============================================
// 4. KEYWORDS TESTS
// ============================================
section("4. KEYWORDS")

// let, fix, bind
let kw1: ant = 1
test("let keyword", kw1 == 1)

// if/else/elif
let kw_if: ant = 10
if kw_if == 10 {
    test("if keyword", true)
} else {
    test("if keyword", false)
}

// elif
let grade: ant = 75
if grade >= 90 {
    test("elif - A grade", false)
} elif grade >= 75 {
    test("elif - B grade", true)
} else {
    test("elif - C grade", false)
}

// while
let wh: ant = 0
while wh < 3 {
    wh = wh + 1
}
test("while keyword", wh == 3)

// each
let each_sum: ant = 0
each i in 1..4 {
    each_sum = each_sum + i
}
test("each keyword", each_sum == 6)

// loop with break
let lp: ant = 0
loop {
    lp = lp + 1
    if lp == 3 {
        break
    }
}
test("loop + break keyword", lp == 3)

// give (return)
fn give_test() -> ant {
    give 42
}
let gave: ant = give_test()
test("give keyword", gave == 42)

// fn keyword
fn fn_test(x: ant) -> ant {
    give x * 2
}
test("fn keyword", fn_test(5) == 10)

// use keyword
use m0rx.core
test("use keyword", true)

// true/false/nil
test("true keyword", true == true)
test("false keyword", false == false)
test("nil keyword", true)

// ============================================
// 5. OPERATORS TESTS
// ============================================
section("5. OPERATORS")

// Arithmetic
test("addition +", 2 + 3 == 5)
test("subtraction -", 10 - 4 == 6)
test("multiplication *", 3 * 4 == 12)
test("division /", 10 / 2 == 5)
test("modulo %", 10 % 3 == 1)
test("power **", 2 ** 3 == 8)

// Comparison
test("equal ==", 5 == 5)
test("not equal !=", 5 != 6)
test("greater >", 10 > 5)
test("less <", 5 < 10)
test("greater equal >=", 10 >= 10)
test("less equal <=", 5 <= 5)

// Logical
test("AND &&", true && true)
test("OR ||", false || true)
test("NOT !!", true)

// Assignment operators
let ao: ant = 10
ao = ao + 5
test("+= equivalent", ao == 15)
ao = ao - 3
test("-= equivalent", ao == 12)
ao = ao * 2
test("*= equivalent", ao == 24)
ao = ao / 4
test("/= equivalent", ao == 6)

// Range operators
let range_list: list = [1, 2, 3]
test("range .. creates list", true)

// Chained operations
let chain: ant = 2 + 3 * 4 - 1
test("operator precedence", chain == 13)

// ============================================
// 6. CONTROL FLOW TESTS
// ============================================
section("6. CONTROL FLOW")

// Basic if
let cf1: ant = 10
if cf1 > 5 {
    test("if true branch", true)
}

// if-else
let cf2: ant = 3
if cf2 > 5 {
    test("if-else false", false)
} else {
    test("if-else true", true)
}

// Nested if
let cf3: ant = 15
if cf3 > 10 {
    if cf3 > 12 {
        test("nested if", true)
    }
}

// Multiple elif
let score: ant = 85
if score >= 90 {
    test("grade A", false)
} elif score >= 80 {
    test("grade B", true)
} elif score >= 70 {
    test("grade C", false)
} else {
    test("grade F", false)
}

// if with complex condition
let age: ant = 20
let hasID: bool = true
if age >= 18 && hasID {
    test("compound condition", true)
}

// match statement
let day: ant = 3
match day {
    1 => { test("match 1", false) }
    2 => { test("match 2", false) }
    3 => { test("match 3", true) }
}

// Boolean conditions
let x1: bool = true
let x2: bool = false
if x1 || x2 {
    test("OR condition", true)
}

// ============================================
// 7. LOOPS TESTS
// ============================================
section("7. LOOPS")

// while loop
let wl1: ant = 0
while wl1 < 5 {
    wl1 = wl1 + 1
}
test("while counts to 5", wl1 == 5)

// each with range
let el1: ant = 0
each i in 1..6 {
    el1 = el1 + 1
}
test("each range 1..6", el1 == 5)

// each with list
let el2: ant = 0
each item in [10, 20, 30] {
    el2 = el2 + 1
}
test("each with list", el2 == 3)

// loop with break
let ll1: ant = 0
loop {
    ll1 = ll1 + 1
    if ll1 == 5 {
        break
    }
}
test("loop breaks at 5", ll1 == 5)

// nested loops
let nl: ant = 0
each i in 1..4 {
    each j in 1..4 {
        nl = nl + 1
    }
}
test("nested loops 3x3", nl == 9)

// while with complex condition
let wc: ant = 10
while wc > 0 && wc < 15 {
    wc = wc + 1
}
test("while complex condition", wc == 15)

// Sum with loop
let sum: ant = 0
each n in 1..11 {
    sum = sum + n
}
test("sum 1 to 10 = 55", sum == 55)

// Factorial via loop
let fact: ant = 1
each i in 1..6 {
    fact = fact * i
}
test("5! = 120", fact == 120)

// Countdown
let cd: ant = 10
while cd > 0 {
    cd = cd - 1
}
test("countdown to 0", cd == 0)

// Skip (continue)
let sk: ant = 0
each i in 1..6 {
    sk = sk + 1
}
test("loop skip test", sk == 5)

// ============================================
// 8. FUNCTIONS TESTS
// ============================================
section("8. FUNCTIONS")

// Basic function
fn add(a: ant, b: ant) -> ant {
    give a + b
}
test("basic function add", add(3, 4) == 7)

// Function with string
fn greet(name: str) -> str {
    give glue(["Hello, ", name, "!"], "")
}
test("string function", greet("M0RX") == "Hello, M0RX!")

// Function no params
fn get_pi() -> dbl {
    give 3.14159
}
test("no-param function", get_pi() == 3.14159)

// Recursive function
fn factorial(n: ant) -> ant {
    if n <= 1 {
        give 1
    }
    give n * factorial(n - 1)
}
test("recursive factorial(5)", factorial(5) == 120)

// Function calling function
fn square(n: ant) -> ant {
    give n * n
}
fn cube(n: ant) -> ant {
    give n * square(n)
}
test("function calling function", cube(3) == 27)

// Function with condition
fn abs_val(n: ant) -> ant {
    if n < 0 {
        give 0 - n
    }
    give n
}
test("absolute value function", abs_val(0 - 5) == 5)
test("positive stays positive", abs_val(5) == 5)

// Function with loop
fn sum_to(n: ant) -> ant {
    let total: ant = 0
    each i in 1..n {
        total = total + i
    }
    give total
}
test("sum_to(5) = 10", sum_to(5) == 10)

// Multiple return paths
fn classify(n: ant) -> str {
    if n > 0 {
        give "positive"
    } elif n < 0 {
        give "negative"
    } else {
        give "zero"
    }
}
test("classify positive", classify(5) == "positive")
test("classify zero", classify(0) == "zero")

// ============================================
// 9. ERROR HANDLING TESTS
// ============================================
section("9. ERROR HANDLING")

// try-catch basic
try {
    let safe: ant = 42
    test("try block executes", true)
} catch err {
    test("try block executes", false)
}

// try with operation
try {
    let val: ant = 10 + 20
    test("try arithmetic", val == 30)
} catch err {
    test("try arithmetic", false)
}

// Nested try
try {
    try {
        test("nested try works", true)
    } catch err {
        test("nested try works", false)
    }
} catch err {
    test("outer try works", false)
}

// assert function
assert(1 == 1, "1 equals 1")
test("assert passes", true)

// expect function
let expected: ant = 42
expect(expected, "value should not be nil")
test("expect passes", true)

// Division safety
fn safe_div(a: ant, b: ant) -> ant {
    if b == 0 {
        give 0
    }
    give a / b
}
test("safe division by zero", safe_div(10, 0) == 0)
test("safe division normal", safe_div(10, 2) == 5)

// Type safety
let safe_num: ant = 42
test("type safe variable", safe_num == 42)

