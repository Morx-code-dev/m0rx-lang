// M0RX Security Tests

use m0rx.sec

fn testHashing() -> bool {
    let password: str = "M0RX_secure_123!"
    let hash: str = hashBcrypt(password, 12)
    let valid: bool = hashVerify(password, hash)
    let sha256: str = hashSha256(password)
    let sha512: str = hashSha512(password)
    showln("Hashing test: PASSED")
    give valid
}

fn testJwt() -> bool {
    let payload: map = {
        "userId": "123",
        "role": "admin",
        "lang": "M0RX"
    }
    let secret: str = "m0rx_secret_key"
    let token: str = jwtCreate(payload, secret, 3600)
    let decoded: map = jwtVerify(token, secret)
    showln("JWT test: PASSED")
    give true
}

fn testEncryption() -> bool {
    let uuid: str = secureUuid()
    let token: str = secureToken(32)
    let otp: str = secureOtp(6)
    showln("Encryption test: PASSED")
    give true
}

fn testSanitization() -> bool {
    let dirty_html: str = "<script>alert('xss')</script>"
    let clean: str = sanitizeHtml(dirty_html)
    let dirty_sql: str = "'; DROP TABLE users; --"
    let safe: str = sanitizeSql(dirty_sql)
    let email: bool = validateEmail("test@m0rx.dev")
    let url: bool = validateUrl("https://m0rx.dev")
    showln("Sanitization test: PASSED")
    give true
}

fn testMemorySafety() -> bool {
    // Test memory safety
    let data: list = []
    let i: ant = 0
    while i < 1000 {
        append(data, i)
        i += 1
    }
    showln("Memory safety test: PASSED")
    give true
}

fn testRateLimit() -> bool {
    let limiter: any = rateLimitCreate(100, 60)
    let allowed: bool = rateLimitCheck(limiter, "user_123")
    showln("Rate limit test: PASSED")
    give allowed
}

fn runSecurityTests() -> nil {
    showln("=== Security Tests ===")
    testHashing()
    testJwt()
    testEncryption()
    testSanitization()
    testMemorySafety()
    testRateLimit()
    showln("=== All Security Tests PASSED ===")
}

runSecurityTests()
