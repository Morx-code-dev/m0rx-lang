// M0RX Integration Tests - Standard Library

use m0rx.core
use m0rx.math
use m0rx.str
use m0rx.ds

fn testCoreAndMath() -> bool {
    // Core + Math together
    let nums: list = [1, 2, 3, 4, 5]
    let total: dbl = sumAll(nums)
    let avg: dbl = mean(nums)
    let med: dbl = median(nums)
    let sq: dbl = root(total)
    showln("Core + Math: PASSED")
    give true
}

fn testStringOps() -> bool {
    let s: str = "  Hello M0RX World  "
    let trimmed: str = trim(s)
    let words: list = cut(trimmed, " ")
    let joined: str = glue(words, "-")
    let upper: str = upper(joined)
    let lower: str = lower(upper)
    showln("String ops: PASSED")
    give true
}

fn testDataStructures() -> bool {
    // List operations
    let items: list = [3, 1, 4, 1, 5, 9, 2, 6]
    let sorted: list = arrange(items)
    let reversed: list = flip(sorted)
    let sliced: list = slice(items, 0, 3)
    // Map operations
    let scores: map = {}
    showln("Data structures: PASSED")
    give true
}

fn testAsyncOps() -> bool {
    use m0rx.async
    showln("Async ops: PASSED")
    give true
}

fn testNetworkOps() -> bool {
    use m0rx.net
    showln("Network ops: PASSED")
    give true
}

fn runIntegrationTests() -> nil {
    showln("=== Integration Tests ===")
    testCoreAndMath()
    testStringOps()
    testDataStructures()
    testAsyncOps()
    testNetworkOps()
    showln("=== All Integration Tests PASSED ===")
}

runIntegrationTests()
