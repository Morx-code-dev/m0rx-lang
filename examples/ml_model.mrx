// M0RX - ML Model Training
use m0rx.ai
use m0rx.math

showln("M0RX ML Example")

// Create neural network
let net: any = nnCreate()
nnAddLayer(net, "dense", {"units": 128, "activation": "relu"})
nnAddLayer(net, "dropout", {"rate": 0.3})
nnAddLayer(net, "dense", {"units": 64, "activation": "relu"})
nnAddLayer(net, "dense", {"units": 10, "activation": "softmax"})
nnCompile(net, "adam", "crossentropy")

showln(nnSummary(net))

// Training data
let xTrain: any = tensorCreate([[1.0, 2.0], [3.0, 4.0]], [2, 2])
let yTrain: any = tensorCreate([[0.0, 1.0], [1.0, 0.0]], [2, 2])

// Train
let history: map = nnTrain(net, xTrain, yTrain, 10, 32)
showln("Training complete!")
showln(history)

// Predict
let input: any = tensorCreate([[1.5, 2.5]], [1, 2])
let output: any = nnPredict(net, input)
showln("Prediction:")
showln(tensorToList(output))

// Save model
nnSave(net, "models/my_model.mrx")
showln("Model saved!")
